{
  "expo": {
    "name": "HirwaPortfolio",
    "slug": "hirwa-portfolio",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "rw.ac.ines.ug2528159.hirwaportfolio",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow HirwaPortfolio to select a profile image.",
          "cameraPermission": "Allow HirwaPortfolio to take a profile image."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a6cba5fd-e5d8-4b71-b2b6-1a26682f1728"
      }
    }
  }
}
